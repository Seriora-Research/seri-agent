{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "powershell -NoProfile -NonInteractive -File .cursor/hooks/block-dangerous.ps1"
      }
    ],
    "beforeReadFile": [
      {
        "command": "powershell -NoProfile -NonInteractive -File .cursor/hooks/block-env-read.ps1"
      }
    ]
  }
}
