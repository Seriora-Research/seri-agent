{
  "name": "seri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun run src/tools/vendorRipgrep.ts",
    "dev": "bun run src/cli.ts",
    "build": "bun run src/build/compile.ts --outfile dist/seri",
    "build:linux-x64": "bun run src/build/compile.ts --target bun-linux-x64 --outfile dist/seri-linux-x64",
    "build:linux-arm64": "bun run src/build/compile.ts --target bun-linux-arm64 --outfile dist/seri-linux-arm64",
    "build:darwin-x64": "bun run src/build/compile.ts --target bun-darwin-x64 --outfile dist/seri-darwin-x64",
    "build:darwin-arm64": "bun run src/build/compile.ts --target bun-darwin-arm64 --outfile dist/seri-darwin-arm64",
    "build:windows-x64": "bun run src/build/compile.ts --target bun-windows-x64 --outfile dist/seri-windows-x64",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64",
    "test": "SERI_DISABLE_MODELS_FETCH=1 bun test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "bun-types": "^1.4.0",
    "@ai-sdk/provider": "^4.0.4",
    "@types/react": "^19.2.0",
    "node-pty": "^1.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/groq": "^4.0.19",
    "@ai-sdk/mcp": "^2.0.40",
    "@ai-sdk/openai": "^4.0.36",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentui/core": "0.5.6",
    "@opentui/react": "0.5.6",
    "@seri/daemon-client": "workspace:*",
    "@seri/model-catalog": "workspace:*",
    "@seri/plans": "workspace:*",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^7.0.47",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
