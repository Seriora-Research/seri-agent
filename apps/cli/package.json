{
  "name": "seri",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun run src/tools/vendorRipgrep.ts",
    "dev": "bun run src/cli.ts",
    "build": "bun build --compile ./src/cli.ts --outfile dist/seri",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 ./src/cli.ts --outfile dist/seri-linux-x64",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 ./src/cli.ts --outfile dist/seri-linux-arm64",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 ./src/cli.ts --outfile dist/seri-darwin-x64",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 ./src/cli.ts --outfile dist/seri-darwin-arm64",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 ./src/cli.ts --outfile dist/seri-windows-x64",
    "build:all": "bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "bun-types": "^1.3.14",
    "@ai-sdk/provider": "^4.0.4"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.19",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^7.0.47",
    "zod": "^4.4.3"
  }
}
